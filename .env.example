# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local

# Google Gemini API key (AI sentence generation & translation)
GEMINI_API_KEY=

# Stack Auth — https://app.stack-auth.com
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=

# Neon PostgreSQL connection string
DATABASE_URL=

# Neon Data API base URL, e.g.
# https://<your-endpoint>.apirest.<region>.aws.neon.tech/neondb/rest/v1
NEXT_PUBLIC_NEON_REST_URL=

# Optional — override the e2e base URL (default http://127.0.0.1:3000)
PLAYWRIGHT_BASE_URL=
